<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Extra hardening for release merges from libraries. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_PRIVILEGED_PHONE_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.REORDER_TASKS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.USE_EXACT_ALARM"
        tools:node="remove" />

    <!-- Strip androidx.test harness activities that leak into release via test deps. -->
    <application>
        <service
            android:name="androidx.work.impl.background.systemjob.SystemJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"
            tools:replace="android:exported,android:permission" />
        <activity
            android:name="androidx.test.core.app.InstrumentationActivityInvoker$BootstrapActivity"
            tools:node="remove" />
        <activity
            android:name="androidx.test.core.app.InstrumentationActivityInvoker$EmptyActivity"
            tools:node="remove" />
        <activity
            android:name="androidx.test.core.app.InstrumentationActivityInvoker$EmptyFloatingActivity"
            tools:node="remove" />

        <!-- Demo / benchmark / screenshot entry points must not be externally callable. -->
        <activity
            android:name="com.yandex.divkit.demo.LauncherActivity"
            android:exported="false"
            tools:replace="android:exported" />
        <activity
            android:name="com.yandex.divkit.demo.div.Div2Activity"
            android:exported="false"
            tools:replace="android:exported" />
        <activity
            android:name="com.yandex.divkit.demo.div.Div2ScenarioActivity"
            android:exported="false"
            tools:replace="android:exported" />
        <activity
            android:name="com.yandex.divkit.demo.screenshot.DivScreenshotActivity"
            android:exported="false"
            tools:replace="android:exported" />
        <activity
            android:name="com.yandex.divkit.demo.benchmark.Div2BenchmarkActivity"
            android:exported="false"
            tools:replace="android:exported" />
        <activity
            android:name="com.yandex.divkit.demo.benchmark.Div2StateBenchmarkActivity"
            android:exported="false"
            tools:replace="android:exported" />
        <activity
            android:name="com.yandex.divkit.demo.benchmark.Div2FeedBenchmarkActivity"
            android:exported="false"
            tools:replace="android:exported" />
        <activity
            android:name="com.yandex.divkit.demo.benchmark.DivStorageBenchmarkActivity"
            android:exported="false"
            tools:replace="android:exported" />
        <activity
            android:name="com.yandex.divkit.regression.RegressionActivity"
            android:exported="false"
            tools:replace="android:exported" />
        <activity
            android:name="com.yandex.divkit.regression.ScenarioActivity"
            android:exported="false"
            tools:replace="android:exported" />
    </application>
</manifest>
