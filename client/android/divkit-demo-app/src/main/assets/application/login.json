        "condition": "@{text_contains_only_valid_characters_password && text_contains_only_valid_characters_username && text_not_are_too_short_username && text_not_are_too_short_password && text_captcha_valid}",
        "mode": "on_condition",
        "actions": [
          {
            "log_id": "login_valid",
            "url": "div-action://set_variable?name=is_valid&value=true"
          }
        ]
      },
      {
        "condition": "@{!text_contains_only_valid_characters_password || !text_contains_only_valid_characters_username || !text_not_are_too_short_username || !text_not_are_too_short_password || !text_captcha_valid}",
        "mode": "on_condition",
        "actions": [
          {
            "log_id": "login_invalid",
            "url": "div-action://set_variable?name=is_valid&value=false"
          }
        ]
      }
    ]
  },
