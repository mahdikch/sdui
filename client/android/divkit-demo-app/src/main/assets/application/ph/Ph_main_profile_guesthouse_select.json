                  "border": {
                    "corner_radius": 8
                  },
                  "paddings": {
                    "top": 14,
                    "bottom": 14
                  },
                  "margins": {
                    "top": 12
                  },
                  "visibility": "@{len(selected_day1_id) > 0 ? 'visible' : 'gone'}",
                  "actions": [
