                  "text": "@{guesthouse_step == 'days' ? 'انتخاب روزهای اقامت' : 'انتخاب مهمانسرا'}",
                  "font_size": 16,
                  "font_weight": "medium",
                  "text_color": "#193d8d",
                  "text_alignment_horizontal": "right",
                  "alignment_horizontal": "right",
                  "width": {
                    "type": "wrap_content"
                  },
                  "height": {
                    "type": "wrap_content"
                  }
                },
                {
                  "type": "text",
                  "text": "بستن",
                  "font_size": 13,
                  "text_color": "#193d8d",
                  "alignment_horizontal": "left",
                  "actions": [
                    {
                      "log_id": "close_guesthouse_select",
                      "url": "div-action://close_bottom_sheet"
                    }
                  ],
                  "width": {
                    "type": "wrap_content"
                  },
                  "height": {
                    "type": "wrap_content"
                  }
                }
              ]
            },
            {
              "type": "container",
              "orientation": "vertical",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "match_parent",
                "weight": 1
              },
              "visibility": "@{guesthouse_step == 'list' ? 'visible' : 'gone'}",
              "items": [
                {
                  "type": "input",
                  "text_variable": "guesthouse_search",
                  "hint_text": "جستجوی مهمانسرا",
                  "hint_color": "#6b7280",
                  "font_size": 13,
                  "text_color": "#1f2937",
                  "text_alignment_horizontal": "right",
                  "width": {
                    "type": "match_parent"
                  },
                  "height": {
                    "type": "wrap_content"
                  },
                  "background": [
                    {
                      "type": "solid",
                      "color": "#f3f5f9"
                    }
                  ],
                  "border": {
                    "corner_radius": 8
                  },
                  "paddings": {
                    "top": 10,
                    "bottom": 10,
                    "start": 12,
                    "end": 12
                  },
                  "margins": {
                    "bottom": 8
                  }
                },
                {
                  "type": "text",
                  "text": "ابتدا مهمانسرا را انتخاب کنید؛ سپس ۱ تا ۳ روز پشت‌سرهم برای اقامت مشخص کنید.",
                  "font_size": 12,
                  "text_color": "#6b7280",
                  "text_alignment_horizontal": "right",
                  "width": {
                    "type": "match_parent"
                  },
                  "margins": {
                    "bottom": 10
                  }
                },
                {
                  "type": "gallery",
                  "orientation": "vertical",
                  "restrict_parent_scroll": true,
                  "width": {
                    "type": "match_parent"
                  },
                  "height": {
                    "type": "match_parent",
                    "weight": 1
                  },
                  "items": [
                    {
                      "type": "container",
                      "orientation": "vertical",
                      "width": {
                        "type": "match_parent"
                      },
                      "height": {
                        "type": "wrap_content"
                      },
                      "item_builder": {
                        "data": "@{guesthouse_places}",
                        "data_element_name": "place",
                        "prototypes": [
                          {
                            "selector": "@{len(guesthouse_search) == 0 || contains(getStringFromDict(place, 'description'), guesthouse_search) || contains(getStringFromDict(place, 'id'), guesthouse_search)}",
                            "div": {
                              "type": "guest_card",
                              "actions": [
                                {
                                  "log_id": "select_guesthouse_id",
                                  "url": "div-action://set_variable?name=selected_guesthouse_id&value=@{getStringFromDict(place, 'id')}"
                                },
                                {
                                  "log_id": "select_guesthouse_name",
                                  "url": "div-action://set_variable?name=selected_guesthouse_name&value=@{getStringFromDict(place, 'description')}"
                                },
                                {
                                  "log_id": "select_guesthouse_step",
                                  "url": "div-action://set_variable?name=guesthouse_step&value=days"
                                },
                                {
                                  "log_id": "clear_day1_id",
                                  "url": "div-action://set_variable?name=selected_day1_id&value="
                                },
                                {
                                  "log_id": "clear_day1_date",
                                  "url": "div-action://set_variable?name=selected_day1_date&value="
                                },
                                {
                                  "log_id": "clear_day1_reserve",
                                  "url": "div-action://set_variable?name=selected_day1_reserve_id&value="
                                },
                                {
                                  "log_id": "clear_day2_id",
                                  "url": "div-action://set_variable?name=selected_day2_id&value="
                                },
                                {
                                  "log_id": "clear_day2_date",
                                  "url": "div-action://set_variable?name=selected_day2_date&value="
                                },
                                {
                                  "log_id": "clear_day2_reserve",
                                  "url": "div-action://set_variable?name=selected_day2_reserve_id&value="
                                },
                                {
                                  "log_id": "clear_day3_id",
                                  "url": "div-action://set_variable?name=selected_day3_id&value="
                                },
                                {
                                  "log_id": "clear_day3_date",
                                  "url": "div-action://set_variable?name=selected_day3_date&value="
                                },
                                {
                                  "log_id": "clear_day3_reserve",
                                  "url": "div-action://set_variable?name=selected_day3_reserve_id&value="
                                },
                                {
                                  "log_id": "clear_window_label",
                                  "url": "div-action://set_variable?name=selected_window_label&value="
                                }
                              ],
                              "items": [
                                {
                                  "type": "text",
                                  "text": "@{getStringFromDict(place, 'description')}",
                                  "font_size": 13,
                                  "font_weight": "medium",
                                  "text_color": "#193d8d",
                                  "text_alignment_horizontal": "right",
                                  "width": {
                                    "type": "match_parent"
                                  }
                                },
                                {
                                  "type": "text",
                                  "text": "کد @{getStringFromDict(place, 'id')}",
                                  "font_size": 11,
                                  "text_color": "#6b7280",
                                  "text_alignment_horizontal": "right",
                                  "width": {
                                    "type": "match_parent"
                                  },
                                  "margins": {
                                    "top": 2
                                  }
                                }
                              ]
                            }
                          }
