                  "type": "gallery",
                  "orientation": "vertical",
                  "restrict_parent_scroll": true,
                  "width": {
                    "type": "match_parent"
                  },
                  "height": {
                    "type": "match_parent",
                    "weight": 1
                  },
                  "items": [
                    {
                      "type": "container",
                      "orientation": "vertical",
                      "width": {
                        "type": "match_parent"
                      },
                      "height": {
                        "type": "wrap_content"
                      },
                      "item_builder": {
                        "data": "@{guesthouse_places}",
                        "data_element_name": "place",
                        "prototypes": [
                          {
                            "selector": "@{getStringFromDict(place, 'id') == selected_guesthouse_id}",
                            "div": {
                              "type": "container",
                              "orientation": "vertical",
                              "width": {
                                "type": "match_parent"
                              },
                              "height": {
                                "type": "wrap_content"
                              },
                              "item_builder": {
                                "data": "@{getArrayFromDict(place, 'calendarPlanDivisionDetail')}",
                                "data_element_name": "day",
                                "prototypes": [
                                  {
                                    "selector": "@{true}",
                                    "div": {
                                      "type": "day_card",
                                      "background": [
                                        {
                                          "type": "solid",
                                          "color": "@{(getStringFromDict(day, 'id') == selected_day1_id || getStringFromDict(day, 'id') == selected_day2_id || getStringFromDict(day, 'id') == selected_day3_id) ? '#e8edf7' : '#f3f5f9'}"
                                        }
                                      ],
                                      "border": {
                                        "corner_radius": 8,
                                        "stroke": {
                                          "color": "@{(getStringFromDict(day, 'id') == selected_day1_id || getStringFromDict(day, 'id') == selected_day2_id || getStringFromDict(day, 'id') == selected_day3_id) ? '#193d8d' : '#c8d0e4'}",
                                          "width": 1
                                        }
                                      },
                                      "actions": [
                                        {
                                          "log_id": "select_guesthouse_start_day",
                                          "url": "div-action://select_guesthouse_start_day?guesthouse_id=@{selected_guesthouse_id}&day_id=@{getStringFromDict(day, 'id')}&date=@{encodeUri(getStringFromDict(day, 'date'))}"
                                        }
                                      ],
                                      "items": [
                                        {
                                          "type": "container",
                                          "orientation": "overlap",
                                          "content_alignment_horizontal": "center",
                                          "content_alignment_vertical": "center",
                                          "width": {
                                            "type": "fixed",
                                            "value": 24
                                          },
                                          "height": {
                                            "type": "fixed",
                                            "value": 24
                                          },
                                          "background": [
                                            {
                                              "type": "solid",
                                              "color": "#193d8d"
                                            }
                                          ],
                                          "border": {
                                            "corner_radius": 12
                                          },
                                          "visibility": "@{(getStringFromDict(day, 'id') == selected_day1_id || getStringFromDict(day, 'id') == selected_day2_id || getStringFromDict(day, 'id') == selected_day3_id) ? 'visible' : 'gone'}",
                                          "margins": {
                                            "end": 8
                                          },
                                          "items": [
                                            {
                                              "type": "text",
                                              "text": "@{getStringFromDict(day, 'id') == selected_day1_id ? '۱' : (getStringFromDict(day, 'id') == selected_day2_id ? '۲' : '۳')}",
                                              "font_size": 11,
                                              "font_weight": "medium",
                                              "text_color": "#ffffff",
                                              "text_alignment_horizontal": "center"
                                            }
                                          ]
                                        },
                                        {
                                          "type": "container",
                                          "orientation": "vertical",
                                          "content_alignment_horizontal": "right",
                                          "width": {
                                            "type": "match_parent"
                                          },
                                          "items": [
                                            {
                                              "type": "text",
                                              "text": "@{getStringFromDict(day, 'dayOfWeek')}  ·  @{getStringFromDict(day, 'date')}",
                                              "font_size": 13,
                                              "font_weight": "medium",
                                              "text_color": "#1f2937",
                                              "text_alignment_horizontal": "right",
                                              "width": {
                                                "type": "match_parent"
                                              }
                                            },
                                            {
                                              "type": "text",
                                              "text": "ظرفیت @{getStringFromDict(day, 'capacity')}",
                                              "font_size": 11,
                                              "text_color": "#6b7280",
                                              "text_alignment_horizontal": "right",
                                              "width": {
                                                "type": "match_parent"
                                              },
                                              "margins": {
                                                "top": 2
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  }
                                ]
                              }
                            }
                          }
                        ]
                      }
                    }
                  ]
                },
