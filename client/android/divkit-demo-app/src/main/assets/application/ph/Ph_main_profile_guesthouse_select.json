                  "type": "text",
                  "text": "تأیید و ادامه",
                  "font_size": 14,
                  "font_weight": "medium",
                  "text_color": "#ffffff",
                  "text_alignment_horizontal": "center",
                  "width": {
                    "type": "match_parent"
                  },
                  "height": {
                    "type": "wrap_content"
                  },
                  "background": [
