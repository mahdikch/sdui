                    {
                      "type": "text",
                      "text": "@{selected_guesthouse_name}",
                      "font_size": 13,
                      "font_weight": "medium",
                      "text_color": "#1f2937",
                      "text_alignment_horizontal": "right",
                      "width": {
                        "type": "match_parent"
                      }
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "روزها را یکی‌یکی انتخاب کنید (حداکثر ۳ روز). روزها باید پشت‌سرهم باشند؛ با زدن دوباره، انتخاب لغو می‌شود.",
                  "font_size": 12,
                  "text_color": "#6b7280",
                  "text_alignment_horizontal": "right",
                  "width": {
                    "type": "match_parent"
                  },
                  "margins": {
                    "bottom": 8
                  }
                },
                {
                  "type": "text",
                  "text": "@{len(selected_day1_id) > 0 ? ('انتخاب‌شده: ' + selected_window_label) : 'هنوز روزی انتخاب نشده (۱ تا ۳ روز پشت‌سرهم)'}",
                  "font_size": 12,
                  "font_weight": "medium",
                  "text_color": "#193d8d",
                  "text_alignment_horizontal": "right",
                  "width": {
                    "type": "match_parent"
                  },
                  "margins": {
                    "bottom": 10
                  }
                },
