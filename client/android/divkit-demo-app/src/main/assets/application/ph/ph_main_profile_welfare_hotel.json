                              "text_color": "#193d8d",
                              "alignment_horizontal": "left",
                              "visibility": "@{(getStringFromDict(request, 'isCancel') == '1' || getStringFromDict(request, 'isCancel') == '2') ? 'visible' : 'gone'}",
                              "width": {
                                "type": "wrap_content"
                              },
                              "actions": [
                                {
                                  "log_id": "delete_or_cancel_hotel_request",
                                  "url": "div-action://call_service?path=hotel/deleteListReservHotels&sysName=hotel&ph/token=empty&confirmed_code=@{getStringFromDict(request, 'confirmed_code')}&stmntType=@{getStringFromDict(request, 'stmntType')}&id=@{getStringFromDict(request, 'id')}&isCancel=@{getStringFromDict(request, 'isCancel')}"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "field_row",
                          "label": "نوع برنامه",
