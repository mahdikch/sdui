          "type": "text",
          "$text": "label",
          "font_size": 12,
          "text_color": "#6b7280",
          "text_alignment_horizontal": "right",
          "width": {
            "type": "wrap_content"
          },
          "margins": {
            "start": 8
          }
        }
      ]
    },
