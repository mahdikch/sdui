                        {
                          "type": "field_row",
                          "label": "تاریخ اجرا",
                          "value_text": "@{getStringFromDict(request, 'exe_date')}"
                        },
                        {
                          "type": "field_row",
                          "label": "امتیاز",
                          "value_text": "@{getStringFromDict(request, 'score')}"
                        },
                        {
                          "type": "field_row",
                          "label": "درخواست هتل",
                          "value_text": "@{getStringFromDict(request, 'hotel_request')}"
                        },
                        {
                          "type": "field_row",
                          "label": "وضعیت درخواست",
                          "value_text": "@{getStringFromDict(request, 'request_status')}"
                        },
                        {
                          "type": "field_row",
                          "label": "علت عدم تخصیص",
