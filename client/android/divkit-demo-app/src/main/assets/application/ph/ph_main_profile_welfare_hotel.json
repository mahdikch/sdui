      "border": {
        "corner_radius": 8,
        "stroke": {
          "color": "#c8d0e4",
          "width": 1
        }
      },
      "paddings": {
        "top": 10,
        "bottom": 10,
        "start": 10,
        "end": 10
      },
      "margins": {
        "bottom": 10
      }
    },
