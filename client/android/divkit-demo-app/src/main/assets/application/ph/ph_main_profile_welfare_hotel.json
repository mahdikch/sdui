                        {
                          "type": "field_row",
                          "label": "وضعیت تصویب",
                          "value_text": "@{getStringFromDict(request, 'approval_status')}"
                        },
                        {
                          "type": "field_row",
                          "label": "شماره حکم",
                          "value_text": "@{getStringFromDict(request, 'decree_number')}"
                        },
                        {
                          "type": "text",
                          "text": "اولویت‌های هتل",
                          "font_size": 12,
                          "font_weight": "medium",
                          "text_color": "#193d8d",
                          "text_alignment_horizontal": "right",
                          "width": {
                            "type": "match_parent"
                          },
                          "margins": {
                            "top": 6,
                            "bottom": 6
                          }
                        },
                        {
                          "type": "container",
                          "orientation": "vertical",
                          "width": {
                            "type": "match_parent"
                          },
                          "height": {
                            "type": "wrap_content"
                          },
                          "item_builder": {
                            "data": "@{getArrayFromDict(request, 'choices')}",
                            "data_element_name": "choice",
                            "prototypes": [
                              {
                                "selector": "@{true}",
                                "div": {
                                  "type": "choice_row"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
