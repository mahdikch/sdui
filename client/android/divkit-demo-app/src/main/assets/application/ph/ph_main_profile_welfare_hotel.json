          "type": "solid",
          "color": "#f3f5f9"
        }
      ],
      "border": {
        "corner_radius": 8
      },
      "paddings": {
        "top": 14,
        "bottom": 14,
        "start": 12,
        "end": 12
      },
      "margins": {
        "bottom": 8
      },
      "actions": [
