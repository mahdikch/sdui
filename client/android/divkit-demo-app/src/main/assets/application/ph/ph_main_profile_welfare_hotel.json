          "type": "text",
          "$text": "value_text",
          "font_size": 12,
          "font_weight": "medium",
          "text_color": "#1f2937",
          "text_alignment_horizontal": "left",
          "width": {
            "type": "match_parent",
            "weight": 1
          }
        },
