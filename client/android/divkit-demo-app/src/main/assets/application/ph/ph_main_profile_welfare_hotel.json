          },
          "paddings": {
            "top": 8,
            "bottom": 16,
            "start": 16,
            "end": 16
          },
          "items": [
            {
              "type": "separator",
              "delimiter_style": {
                "color": "#d1d5db"
              },
              "width": {
                "type": "fixed",
                "value": 40
              },
              "height": {
                "type": "fixed",
                "value": 4
              },
              "alignment_horizontal": "center",
              "border": {
                "corner_radius": 2
              },
              "margins": {
                "bottom": 12
              }
            },
            {
              "type": "container",
              "orientation": "overlap",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "wrap_content"
              },
              "margins": {
                "bottom": 12
              },
              "items": [
                {
                  "type": "text",
                  "text": "هتل",
                  "font_size": 16,
                  "font_weight": "medium",
                  "text_color": "#193d8d",
                  "text_alignment_horizontal": "right",
                  "alignment_horizontal": "right",
                  "width": {
                    "type": "wrap_content"
                  },
                  "height": {
                    "type": "wrap_content"
                  }
                },
                {
                  "type": "text",
                  "text": "بستن",
                  "font_size": 13,
                  "text_color": "#193d8d",
                  "alignment_horizontal": "left",
                  "actions": [
                    {
                      "log_id": "close_welfare_hotel",
                      "url": "div-action://close_bottom_sheet"
                    }
                  ],
                  "width": {
                    "type": "wrap_content"
                  },
                  "height": {
                    "type": "wrap_content"
                  }
                }
              ]
            },
            {
              "type": "option_row",
              "title": "عادی",
              "action_url": "div-action://call_service?path=hotel/listHotels&ph/token=empty&sysName=hotel&policeCode=empty"
            },
            {
              "type": "option_row",
              "title": "تربیت تعالی",
              "action_url": "div-action://close_bottom_sheet"
            },
            {
              "type": "text",
              "text": "لیست درخواست‌ها",
              "font_size": 13,
              "font_weight": "medium",
              "text_color": "#193d8d",
              "text_alignment_horizontal": "right",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "wrap_content"
              },
              "margins": {
                "top": 8,
                "bottom": 8
              }
            },
            {
              "type": "text",
              "text": "درخواستی ثبت نشده است",
              "font_size": 13,
              "text_color": "#6b7280",
              "text_alignment_horizontal": "center",
              "width": {
                "type": "match_parent"
              },
              "visibility": "@{len(requests) == 0 ? 'visible' : 'gone'}",
              "paddings": {
                "top": 16,
                "bottom": 16
              }
            },
            {
              "type": "gallery",
              "orientation": "vertical",
              "restrict_parent_scroll": true,
              "visibility": "@{len(requests) == 0 ? 'gone' : 'visible'}",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "match_parent",
                "weight": 1
              },
              "item_builder": {
                "data": "@{requests}",
                "data_element_name": "request",
                "prototypes": [
                  {
                    "selector": "@{true}",
                    "div": {
                      "type": "request_card",
                      "items": [
                        {
                          "type": "container",
                          "orientation": "overlap",
                          "width": {
                            "type": "match_parent"
                          },
                          "height": {
                            "type": "wrap_content"
                          },
                          "margins": {
                            "bottom": 8
                          },
                          "items": [
                            {
