              "visibility_duration": 0
            },
            {
              "log_id": "list_facility_details",
              "url": "div-action://array_to_list_db?array=form&key=FACILITY_DETAILS&id=id&title=%7Bid%7D%20%7C%20%D9%85%D8%A8%D9%84%D8%BA%3A%20%7BloanAmount%3Anumber%7D%20%7C%20%D9%86%D8%B1%D8%AE%3A%20%7BloanFacilityRate%7D%20%D8%AF%D8%B1%D8%B5%D8%AF",
              "visibility_duration": 0
            },
            {
              "log_id": "list_fund_type",
              "url": "div-action://array_to_list_db?array=fund_type_options&key=FUND_TYPE&id=id&title=%7Btitle%7D",
              "visibility_duration": 0
            },
            {
              "log_id": "list_dependency_decree",
              "url": "div-action://array_to_list_db?array=form&key=DEPENDENCY_DECREE&nested=sponseredMember&id=id&title=%7Bid%7D%20%7C%20%7Bname%7D%20%7Bfamily%7D%20%7C%20%7BbirthDate%7D%20%7C%20%7BmarriageDate%7D&unique=true",
              "visibility_duration": 0
            },
            {
              "log_id": "list_transfer_decree",
