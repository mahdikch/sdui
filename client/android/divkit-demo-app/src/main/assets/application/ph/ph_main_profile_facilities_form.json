                {
                  "type": "text",
                  "text": "ثبت درخواست",
                  "font_size": 14,
                  "font_weight": "medium",
                  "text_color": "#ffffff",
                  "text_alignment_horizontal": "center",
                  "width": {
                    "type": "wrap_content"
                  },
                  "height": {
                    "type": "wrap_content"
                  }
                }
              ]
            }
          ]
        }
