              "visibility": "@{facility_extra_field == 'imperfective' ? 'visible' : 'gone'}"
            },
            {
              "type": "select_row",
              "label": "حکم وابستگی",
              "value_text": "@{facility_decree}",
              "action_url": "div-action://bottom_sheet_list?id=DEPENDENCY_DECREE&varName=DEPENDENCY_DECREE&title=حکم وابستگی&title_var=facility_decree&code_var=facility_sponsored_member_id",
              "visibility": "@{facility_extra_field == 'dependency' ? 'visible' : 'gone'}"
            },
            {
              "type": "select_row",
              "label": "حکم انتقال",
              "value_text": "@{facility_decree}",
              "action_url": "div-action://bottom_sheet_list?id=TRANSFER_DECREE&varName=TRANSFER_DECREE&title=حکم انتقال&title_var=facility_decree&code_var=facility_enteghal_state_id&sync_from=form&sync_nested=enteghalStateDto&sync_match=id&sync_fields=executeDateMiladi:facility_execute_date_miladi",
              "visibility": "@{facility_extra_field == 'transfer' ? 'visible' : 'gone'}"
            },
            {
              "type": "container",
              "orientation": "overlap",
              "content_alignment_horizontal": "center",
              "content_alignment_vertical": "center",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "fixed",
                "value": 44
              },
              "background": [
                {
                  "type": "solid",
                  "color": "#193d8d"
                }
              ],
              "border": {
                "corner_radius": 8
              },
              "margins": {
                "top": 8
              },
