{
  "card": {
    "log_id": "profile_facilities_form_bottomsheet",
    "states": [
      {
        "state_id": 0,
        "div": {
          "type": "container",
          "orientation": "vertical",
          "width": {
            "type": "match_parent"
          },
          "height": {
            "type": "wrap_content"
          },
          "background": [
            {
              "type": "solid",
              "color": "#ffffff"
            }
          ],
          "border": {
            "corners_radius": {
              "top-left": 16,
              "top-right": 16
            }
          },
          "paddings": {
            "top": 8,
            "bottom": 16,
            "start": 16,
            "end": 16
          },
          "visibility_actions": [
            {
              "log_id": "init_facility_title",
              "url": "div-action://set_variable_from_array?array=form&index=0&path=loanType.description&name=facility_request_title",
              "visibility_duration": 0
            },
            {
              "log_id": "init_facility_salary_raw",
              "url": "div-action://set_variable_from_array?array=form&index=0&path=salaryOneThird&name=facility_salary_third_raw",
              "visibility_duration": 0
            },
            {
              "log_id": "init_facility_salary_display",
              "url": "div-action://set_variable_from_array?array=form&index=0&path=salaryOneThird&name=facility_salary_third&format=number",
              "visibility_duration": 0
            },
            {
              "log_id": "init_facility_execute_date",
