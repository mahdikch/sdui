              "text_color": "#b45309",
              "text_alignment_horizontal": "right",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "wrap_content"
              },
              "background": [
                {
                  "type": "solid",
                  "color": "#fffbeb"
                }
              ],
              "border": {
                "corner_radius": 8
              },
              "paddings": {
                "top": 10,
                "bottom": 10,
                "start": 12,
                "end": 12
              },
              "margins": {
                "bottom": 12
              },
              "visibility": "@{facility_extra_field == 'housing' ? 'visible' : 'gone'}"
            },
            {
              "type": "select_row",
              "label": "جزییات تسهیلات",
              "value_text": "@{facility_details}",
              "action_url": "div-action://bottom_sheet_list?id=FACILITY_DETAILS&varName=FACILITY_DETAILS&title=جزییات تسهیلات&title_var=facility_details&code_var=facility_details_code&sync_from=form&sync_match=id&sync_fields=executeDateMiladi:facility_execute_date_miladi,salaryOneThird:facility_salary_third_raw,salaryOneThird:facility_salary_third%7Cnumber,loanType.id:facility_sub_state_type_id"
            },
            {
              "type": "readonly_row",
              "label": "تسهیلات درخواستی",
              "value_text": "@{facility_request_title}"
            },
            {
              "type": "readonly_row",
              "label": "یک سوم حقوق",
              "value_text": "@{facility_salary_third}"
            },
            {
              "type": "select_row",
              "label": "نوع صندوق",
              "value_text": "@{facility_fund_type}",
