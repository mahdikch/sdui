{
  "templates": {
    "page_title": {
      "type": "text",
      "font_size": 14,
      "font_weight": "medium",
      "text_color": "#193d8d",
      "text_alignment_horizontal": "right",
      "width": {
        "type": "wrap_content"
      },
      "height": {
        "type": "wrap_content"
      }
    },
    "section_label": {
      "type": "text",
      "font_size": 12,
      "font_weight": "medium",
      "text_color": "#6b7280",
      "text_alignment_horizontal": "right",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      },
      "margins": {
        "bottom": 6
      }
    },
    "field_box": {
      "type": "container",
      "orientation": "horizontal",
      "content_alignment_horizontal": "right",
      "content_alignment_vertical": "center",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      },
      "background": [
        {
          "type": "solid",
          "color": "#ffffff"
        }
      ],
      "border": {
        "corner_radius": 8,
        "stroke": {
          "color": "#c8d0e4",
          "width": 1
        }
      },
      "paddings": {
        "top": 10,
        "bottom": 10,
        "start": 12,
        "end": 12
      },
      "margins": {
        "bottom": 10
      }
    },
    "primary_btn": {
      "type": "text",
      "font_size": 14,
      "font_weight": "medium",
      "text_color": "#ffffff",
      "text_alignment_horizontal": "center",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      },
      "background": [
        {
          "type": "solid",
          "color": "#193d8d"
        }
      ],
      "border": {
        "corner_radius": 8
      },
      "paddings": {
        "top": 14,
        "bottom": 14
      }
    },
    "secondary_btn": {
      "type": "text",
      "font_size": 14,
      "font_weight": "medium",
      "text_color": "#193d8d",
      "text_alignment_horizontal": "center",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      },
      "background": [
        {
          "type": "solid",
          "color": "#f3f5f9"
        }
      ],
      "border": {
        "corner_radius": 8
      },
      "paddings": {
        "top": 14,
        "bottom": 14
      },
      "margins": {
        "top": 8
      }
    }
  },
  "card": {
    "log_id": "accidents_uncompromising_pedestrianinformation",
    "variables": [
      {
        "type": "string",
        "name": "empty",
        "value": ""
      },
      {
        "type": "string",
        "name": "current_accident_id",
        "value": ""
      },
      {
        "type": "string",
        "name": "current_pedestrian_id",
        "value": ""
      },
      {
        "type": "integer",
        "name": "current_step",
        "value": 4
      },
      {
        "type": "integer",
        "name": "total",
        "value": 11
      },
      {
        "type": "boolean",
        "name": "index1",
        "value": false
      },
      {
        "type": "string",
        "name": "checked",
        "value": "divkit-asset://checkbox-checked.png"
      },
      {
        "type": "string",
        "name": "unchecked",
        "value": "divkit-asset://checkbox-unchecked.png"
      }
    ],
    "states": [
      {
        "state_id": 0,
        "div": {
          "type": "container",
          "orientation": "vertical",
          "width": {
            "type": "match_parent"
          },
          "height": {
            "type": "match_parent"
          },
          "background": [
            {
              "type": "solid",
              "color": "#ffffff"
            }
          ],
          "paddings": {
            "top": 12,
            "bottom": 12,
            "start": 16,
            "end": 16
          },
          "visibility_actions": [
            {
              "log_id": "load_accident_id",
              "url": "div-action://set_variable_from_db?name=current_accident_id",
              "visibility_duration": 0
            }
          ],
          "items": [
            {
              "type": "container",
              "orientation": "overlap",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "wrap_content"
              },
              "margins": {
                "bottom": 8
              },
              "items": [
                {
                  "type": "page_title",
                  "text": "ثبت تصادف غیرسازشی",
                  "alignment_horizontal": "right"
                },
                {
                  "type": "text",
                  "text": "بازگشت",
                  "font_size": 12,
                  "text_color": "#193d8d",
                  "alignment_horizontal": "left",
                  "width": {
                    "type": "wrap_content"
                  },
                  "height": {
                    "type": "wrap_content"
                  },
                  "actions": [
                    {
                      "log_id": "back",
                      "url": "div-action://pop_and_load_screen"
                    }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "orientation": "horizontal",
              "content_alignment_vertical": "center",
              "content_alignment_horizontal": "right",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "wrap_content"
              },
              "background": [
                {
                  "type": "solid",
                  "color": "#f3f5f9"
                }
              ],
              "border": {
                "corner_radius": 8
              },
              "paddings": {
                "top": 6,
                "bottom": 6,
                "start": 8,
                "end": 8
              },
              "margins": {
                "bottom": 8
              },
              "items": [
                {
                  "type": "custom",
                  "custom_type": "circular_progress",
                  "custom_props": {
                    "current": "@{current_step}",
                    "total": "@{total}"
                  },
                  "width": {
                    "type": "fixed",
                    "value": 36
                  },
                  "height": {
                    "type": "fixed",
                    "value": 36
                  },
                  "margins": {
                    "end": 8
                  }
                },
                {
                  "type": "container",
                  "orientation": "vertical",
                  "width": {
                    "type": "match_parent"
                  },
                  "height": {
                    "type": "wrap_content"
                  },
                  "items": [
                    {
                      "type": "text",
                      "text": "اطلاعات عابران",
                      "font_size": 12,
                      "font_weight": "medium",
                      "text_color": "#1f2937",
                      "text_alignment_horizontal": "right",
                      "width": {
                        "type": "match_parent"
                      },
                      "height": {
                        "type": "wrap_content"
                      }
                    },
                    {
                      "type": "text",
                      "text": "بعدی: سازمان / اشخاص حقوقی",
                      "font_size": 10,
                      "text_color": "#6b7280",
                      "text_alignment_horizontal": "right",
                      "width": {
                        "type": "match_parent"
                      },
                      "height": {
                        "type": "wrap_content"
                      },
                      "margins": {
                        "top": 1
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "gallery",
              "orientation": "vertical",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "match_parent",
                "weight": 1
              },
              "items": [
                {
                  "type": "section_label",
                  "text": "وضعیت عابر"
                },
                {
                  "type": "field_box",
                  "actions": [
                    {
                      "log_id": "toggle_no_pedestrian",
                      "url": "div-action://set_variable?name=index1&value=@{index1 ? false : true}"
                    }
                  ],
                  "items": [
                    {
                      "type": "image",
                      "image_url": "@{index1 ? checked : unchecked}",
                      "width": {
                        "type": "fixed",
                        "value": 22
                      },
                      "height": {
                        "type": "fixed",
                        "value": 22
                      },
                      "preload_required": true,
                      "margins": {
                        "end": 8
                      }
                    },
                    {
                      "type": "text",
                      "text": "عابر ندارد",
                      "font_size": 13,
                      "text_color": "#1f2937",
                      "text_alignment_horizontal": "right",
                      "width": {
                        "type": "match_parent"
                      },
                      "height": {
                        "type": "wrap_content"
                      }
                    }
                  ]
                },
                {
                  "type": "section_label",
                  "text": "عابران",
                  "visibility": "@{index1 ? 'gone' : 'visible'}"
                },
                {
                  "type": "container",
                  "orientation": "horizontal",
                  "content_alignment_horizontal": "center",
                  "content_alignment_vertical": "center",
                  "width": {
                    "type": "match_parent"
                  },
                  "height": {
                    "type": "wrap_content"
                  },
                  "visibility": "@{index1 ? 'gone' : 'visible'}",
                  "background": [
                    {
                      "type": "solid",
                      "color": "#f3f5f9"
                    }
                  ],
                  "border": {
                    "corner_radius": 8,
                    "stroke": {
                      "color": "#c8d0e4",
                      "width": 1
                    }
                  },
                  "paddings": {
                    "top": 12,
                    "bottom": 12
                  },
                  "margins": {
                    "bottom": 10
                  },
                  "actions": [
                    {
                      "log_id": "set_random_id_to_db",
                      "url": "div-action://set_random_id_to_db?key=current_pedestrian_id"
                    },
                    {
                      "log_id": "open_add_pedestrian",
                      "url": "div-action://load_screen?screen=Accidents/uncompromising/pedestrianspecification"
                    }
                  ],
                  "items": [
                    {
                      "type": "text",
                      "text": "افزودن عابر",
                      "font_size": 13,
                      "font_weight": "medium",
                      "text_color": "#193d8d",
                      "text_alignment_horizontal": "center",
                      "width": {
                        "type": "wrap_content"
                      },
                      "height": {
                        "type": "wrap_content"
                      }
                    }
                  ]
                },
                {
                  "type": "custom",
                  "custom_type": "offline_list_container",
                  "visibility": "@{index1 ? 'gone' : 'visible'}",
                  "custom_props": {
                    "screen": "pedestrians",
                    "accident_id": "@{current_accident_id}"
                  },
                  "width": {
                    "type": "match_parent"
                  },
                  "height": {
                    "type": "wrap_content"
                  }
                }
              ]
            },
            {
              "type": "container",
              "orientation": "horizontal",
              "content_alignment_vertical": "center",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "wrap_content"
              },
              "margins": {
                "top": 10
              },
              "items": [
                {
                  "type": "primary_btn",
                  "text": "مرحله بعد",
                  "width": {
                    "type": "match_parent",
                    "weight": 1
                  },
                  "margins": {
                    "start": 4
                  },
                  "actions": [
                    {
                      "log_id": "save_draft_page2",
                      "url": "div-action://set_page_with_changes_to_db?key=draft/@{current_accident_id}/page4"
                    },
                    {
                      "log_id": "save_archive_index",
                      "url": "div-action://set_object_to_db?archive_path=Accidents&next=draft/@{current_accident_id}/page2&title=ثبت تصادف غیر سازشی&accident_id=@{current_accident_id}&current_step=4&process_type=sazeshi&step_dbshow=صفحه ۴ از ۵&step_persian_lan=مرحله&accident_id_dbshow=@{current_accident_id}&accident_id_persian_lan=شناسه"
                    },
                    {
                      "log_id": "set_step",
                      "url": "div-action://set_variable_to_db?key=current_step&value=5"
                    },
                    {
                      "log_id": "load_screen",
                      "url": "div-action://load_screen?screen=Accidents/uncompromising/organizationlegalentities"
                    }
                  ]
                },
                {
                  "type": "secondary_btn",
                  "text": "مرحله قبل",
                  "width": {
                    "type": "match_parent",
                    "weight": 1
                  },
                  "margins": {
                    "top": 0,
                    "end": 4
                  },
                  "actions": [
                    {
                      "log_id": "back",
                      "url": "div-action://pop_and_load_screen"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
