{
  "templates": {
    "page_title": {
      "type": "text",
      "font_size": 14,
      "font_weight": "medium",
      "text_color": "#193d8d",
      "text_alignment_horizontal": "right",
      "width": {
        "type": "wrap_content"
      },
      "height": {
        "type": "wrap_content"
      }
    },
    "section_label": {
      "type": "text",
      "font_size": 12,
      "font_weight": "medium",
      "text_color": "#6b7280",
      "text_alignment_horizontal": "right",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      },
      "margins": {
        "bottom": 6
      }
    },
    "group_header": {
      "type": "container",
      "orientation": "horizontal",
      "content_alignment_vertical": "center",
      "content_alignment_horizontal": "right",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      },
      "background": [
        {
          "type": "solid",
          "color": "#eef3fb"
        }
      ],
      "border": {
        "corner_radius": 10
      },
      "paddings": {
        "top": 10,
        "bottom": 10,
        "start": 12,
        "end": 12
      },
      "margins": {
        "top": 6,
        "bottom": 12
      }
    },
    "group_header_text": {
      "type": "text",
      "font_size": 13,
      "font_weight": "medium",
      "text_color": "#193d8d",
      "text_alignment_horizontal": "right",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      }
    },
    "field_box": {
      "type": "container",
      "orientation": "horizontal",
      "content_alignment_horizontal": "right",
      "content_alignment_vertical": "center",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      },
      "background": [
        {
          "type": "solid",
          "color": "#ffffff"
        }
      ],
      "border": {
        "corner_radius": 10,
        "stroke": {
          "color": "#dbe3f0",
          "width": 1
        }
      },
      "paddings": {
        "top": 12,
        "bottom": 12,
        "start": 12,
        "end": 12
      },
      "margins": {
        "bottom": 10
      }
    },
    "field_value": {
      "type": "text",
      "font_size": 13,
      "text_color": "#1f2937",
      "text_alignment_horizontal": "right",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      }
    },
    "field_input": {
      "type": "input",
      "font_size": 13,
      "text_color": "#1f2937",
      "hint_color": "#9ca3af",
      "text_alignment_horizontal": "right",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      }
    },
    "validation_text": {
      "type": "text",
      "font_size": 12,
      "font_weight": "medium",
      "text_color": "#dc2626",
      "text_alignment_horizontal": "right",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      },
      "margins": {
        "bottom": 6
      }
    },
    "primary_btn": {
      "type": "text",
      "font_size": 14,
      "font_weight": "medium",
      "text_color": "#ffffff",
      "text_alignment_horizontal": "center",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      },
      "background": [
        {
          "type": "solid",
          "color": "#193d8d"
        }
      ],
      "border": {
        "corner_radius": 10
      },
      "paddings": {
        "top": 14,
        "bottom": 14
      }
    },
    "secondary_btn": {
      "type": "text",
      "font_size": 14,
      "font_weight": "medium",
      "text_color": "#193d8d",
      "text_alignment_horizontal": "center",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      },
      "background": [
        {
          "type": "solid",
          "color": "#ffffff"
        }
      ],
      "border": {
        "corner_radius": 10,
        "stroke": {
          "color": "#c8d0e4",
          "width": 1
        }
      },
      "paddings": {
        "top": 14,
        "bottom": 14
      }
    }
  },
  "card": {
    "log_id": "accidents_uncompromising_expertreasoning",
    "variables": [
      {
        "type": "dict",
        "name": "local_palette",
        "value": {
          "bg_primary": {
            "name": "Primary background",
            "light": "#fff",
            "dark": "#000"
          },
          "color0": {
            "name": "Secondary background",
            "light": "#eeeeee",
            "dark": "#000"
          }
        }
      },
      {
        "type": "string",
        "name": "empty",
        "value": ""
      },
      {
        "type": "string",
        "name": "refresh",
        "value": "empty://"
      },
      {
        "type": "string",
        "name": "arrow_right",
        "value": "empty://"
      },
      {
        "type": "string",
        "name": "current_accident_id",
        "value": ""
      },
      {
        "type": "string",
        "name": "current_step",
        "value": "8"
      },
      {
        "type": "string",
        "name": "total_step",
        "value": "11"
      },
      {
        "type": "string",
        "name": "variable_explanation",
        "value": ""
      },
      {
        "type": "boolean",
        "name": "validation_explanation",
        "value": false
      },
      {
        "type": "boolean",
        "name": "attempted_next",
        "value": false
      },
      {
        "type": "boolean",
        "name": "validation_next_page",
        "value": false
      }
    ],
    "variable_triggers": [
      {
        "condition": "@{variable_explanation != empty}",
        "mode": "on_condition",
        "actions": [
          {
            "log_id": "explanation_ok",
            "url": "div-action://set_variable?name=validation_explanation&value=true"
          }
        ]
      },
      {
        "condition": "@{variable_explanation == empty}",
        "mode": "on_condition",
        "actions": [
          {
            "log_id": "explanation_bad",
            "url": "div-action://set_variable?name=validation_explanation&value=false"
          }
        ]
      },
      {
        "condition": "@{validation_explanation}",
        "mode": "on_condition",
        "actions": [
          {
            "log_id": "next_ok",
            "url": "div-action://set_variable?name=validation_next_page&value=true"
          }
        ]
      },
      {
        "condition": "@{!validation_explanation}",
        "mode": "on_condition",
        "actions": [
          {
            "log_id": "next_bad",
            "url": "div-action://set_variable?name=validation_next_page&value=false"
          }
        ]
      }
    ],
    "states": [
      {
        "state_id": 0,
        "div": {
          "type": "container",
          "orientation": "vertical",
          "width": {
            "type": "match_parent"
          },
          "height": {
            "type": "match_parent"
          },
          "background": [
            {
              "type": "solid",
              "color": "#f3f5f9"
            }
          ],
          "paddings": {
            "top": 12,
            "bottom": 12,
            "start": 16,
            "end": 16
          },
          "visibility_actions": [
            {
              "log_id": "load_accident_id",
              "url": "div-action://set_variable_from_db?name=current_accident_id",
              "visibility_duration": 0
            }
          ],
          "items": [
            {
              "type": "container",
              "orientation": "overlap",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "wrap_content"
              },
              "margins": {
                "bottom": 10
              },
              "items": [
                {
                  "type": "page_title",
                  "text": "ثبت تصادف غیرسازشی",
                  "alignment_horizontal": "right"
                },
                {
                  "type": "text",
                  "text": "بازگشت",
                  "font_size": 12,
                  "text_color": "#193d8d",
                  "alignment_horizontal": "left",
                  "width": {
                    "type": "wrap_content"
                  },
                  "height": {
                    "type": "wrap_content"
                  },
                  "actions": [
                    {
                      "log_id": "back",
                      "url": "div-action://pop_and_load_screen"
                    }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "orientation": "horizontal",
              "content_alignment_vertical": "center",
              "content_alignment_horizontal": "right",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "wrap_content"
              },
              "background": [
                {
                  "type": "solid",
                  "color": "#ffffff"
                }
              ],
              "border": {
                "corner_radius": 12,
                "stroke": {
                  "color": "#dbe3f0",
                  "width": 1
                }
              },
              "paddings": {
                "top": 10,
                "bottom": 10,
                "start": 12,
                "end": 12
              },
              "margins": {
                "bottom": 10
              },
              "items": [
                {
                  "type": "custom",
                  "custom_type": "circular_progress",
                  "custom_props": {
                    "current": "@{current_step}",
                    "total": "@{total_step}"
                  },
                  "width": {
                    "type": "fixed",
                    "value": 40
                  },
                  "height": {
                    "type": "fixed",
                    "value": 40
                  },
                  "margins": {
                    "end": 10
                  }
                },
                {
                  "type": "container",
                  "orientation": "vertical",
                  "width": {
                    "type": "match_parent"
                  },
                  "height": {
                    "type": "wrap_content"
                  },
                  "items": [
                    {
                      "type": "text",
                      "text": "استدلال و استنتاج کارشناسی",
                      "font_size": 13,
                      "font_weight": "medium",
                      "text_color": "#1f2937",
                      "text_alignment_horizontal": "right",
                      "width": {
                        "type": "match_parent"
                      },
                      "height": {
                        "type": "wrap_content"
                      }
                    },
                    {
                      "type": "text",
                      "text": "مرحله @{current_step} از @{total_step}  ·  بعدی: ترسیم کروکی",
                      "font_size": 11,
                      "text_color": "#6b7280",
                      "text_alignment_horizontal": "right",
                      "width": {
                        "type": "match_parent"
                      },
                      "height": {
                        "type": "wrap_content"
                      },
                      "margins": {
                        "top": 2
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "orientation": "horizontal",
              "content_alignment_vertical": "center",
              "content_alignment_horizontal": "right",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "wrap_content"
              },
              "background": [
                {
                  "type": "solid",
                  "color": "#eef3fb"
                }
              ],
              "border": {
                "corner_radius": 10
              },
              "paddings": {
                "top": 10,
                "bottom": 10,
                "start": 12,
                "end": 12
              },
              "margins": {
                "bottom": 12
              },
              "items": [
                {
                  "type": "text",
                  "text": "توضیحات کارشناسی الزامی است. پس از تکمیل می‌توانید به ترسیم کروکی بروید.",
                  "font_size": 11,
                  "text_color": "#3b5b9a",
                  "text_alignment_horizontal": "right",
                  "width": {
                    "type": "match_parent"
                  },
                  "height": {
                    "type": "wrap_content"
                  }
                }
              ]
            },
            {
              "type": "gallery",
              "orientation": "vertical",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "match_parent",
                "weight": 1
              },
              "items": [
                {
                  "type": "container",
                  "orientation": "vertical",
                  "width": {
                    "type": "match_parent"
                  },
                  "height": {
                    "type": "wrap_content"
                  },
                  "background": [
                    {
                      "type": "solid",
                      "color": "#fef2f2"
                    }
                  ],
                  "border": {
                    "corner_radius": 8
                  },
                  "paddings": {
                    "top": 10,
                    "bottom": 6,
                    "start": 12,
                    "end": 12
                  },
                  "margins": {
                    "bottom": 10
                  },
                  "visibility": "@{attempted_next && !validation_next_page ? 'visible' : 'gone'}",
                  "items": [
                    {
                      "type": "text",
                      "text": "لطفاً موارد الزامی را تکمیل کنید",
                      "font_size": 13,
                      "font_weight": "medium",
                      "text_color": "#b91c1c",
                      "text_alignment_horizontal": "right",
                      "width": {
                        "type": "match_parent"
                      },
                      "height": {
                        "type": "wrap_content"
                      },
                      "margins": {
                        "bottom": 6
                      }
                    },
                    {
                      "type": "validation_text",
                      "text": "توضیحات کارشناسی اجباری می باشد.",
                      "visibility": "@{validation_explanation ? 'gone' : 'visible'}"
                    }
                  ]
                },
                {
                  "type": "group_header",
                  "items": [
                    {
                      "type": "group_header_text",
                      "text": "۱  ·  توضیحات کارشناسی"
                    }
                  ]
                },
                {
                  "type": "section_label",
                  "text": "توضیحات کارشناسی *"
                },
                {
                  "type": "field_box",
                  "orientation": "vertical",
                  "content_alignment_vertical": "top",
                  "items": [
                    {
                      "type": "field_input",
                      "text_variable": "variable_explanation",
                      "hint_text": "توضیحات کارشناسی در این قسمت نوشته می شود",
                      "height": {
                        "type": "fixed",
                        "value": 112
                      },
                      "text_alignment_vertical": "top"
                    }
                  ]
                },
                {
                  "type": "group_header",
                  "items": [
                    {
                      "type": "group_header_text",
                      "text": "۲  ·  مقصرین"
                    }
                  ]
                },
                {
                  "type": "section_label",
                  "text": "مقصرین"
                },
                {
                  "type": "field_box",
                  "orientation": "vertical",
                  "content_alignment_vertical": "top",
                  "background": [
                    {
                      "type": "solid",
                      "color": "#f8fafc"
                    }
                  ],
                  "items": [
                    {
                      "type": "text",
                      "text": "راننده مقصر",
                      "font_size": 13,
                      "font_weight": "medium",
                      "text_color": "#193d8d",
                      "text_alignment_horizontal": "right",
                      "width": {
                        "type": "match_parent"
                      },
                      "height": {
                        "type": "wrap_content"
                      },
                      "margins": {
                        "bottom": 8
                      }
                    },
                    {
                      "type": "field_value",
                      "text": "عدم رعایت فاصه عرضی - نقض ماده 133آیین نامه راهور",
                      "margins": {
                        "bottom": 6
                      }
                    },
                    {
                      "type": "field_value",
                      "text": "دنا پلاس",
                      "text_color": "#6b7280",
                      "font_size": 12
                    }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "orientation": "horizontal",
              "content_alignment_vertical": "center",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "wrap_content"
              },
              "margins": {
                "top": 10
              },
              "items": [
                {
                  "type": "primary_btn",
                  "text": "مرحله بعد",
                  "width": {
                    "type": "match_parent",
                    "weight": 1
                  },
                  "margins": {
                    "start": 4
                  },
                  "actions": [
                    {
                      "log_id": "attempt_show_errors",
                      "is_enabled": "@{!validation_next_page}",
                      "url": "div-action://set_variable?name=attempted_next&value=true"
                    },
                    {
                      "log_id": "toast_validation",
                      "is_enabled": "@{!validation_next_page}",
                      "url": "div-action://show_toast?massage=لطفاً فیلدهای الزامی را تکمیل کنید"
                    },
                    {
                      "log_id": "save_draft_page2",
                      "is_enabled": "@{validation_next_page}",
                      "url": "div-action://set_page_with_changes_to_db?key=draft/@{current_accident_id}/page8"
                    },
                    {
                      "log_id": "save_archive_index",
                      "is_enabled": "@{validation_next_page}",
                      "url": "div-action://set_object_to_db?archive_path=Accidents&next=draft/@{current_accident_id}/page2&title=ثبت تصادف غیر سازشی&accident_id=@{current_accident_id}&current_step=3&process_type=sazeshi&step_dbshow=صفحه ۲ از ۴&step_persian_lan=مرحله&accident_id_dbshow=@{current_accident_id}&accident_id_persian_lan=شناسه"
                    },
                    {
                      "log_id": "set_step",
                      "is_enabled": "@{validation_next_page}",
                      "url": "div-action://set_variable_to_db?key=current_step&value=9"
                    },
                    {
                      "log_id": "load_screen",
                      "is_enabled": "@{validation_next_page}",
                      "url": "div-action://load_screen?screen=Accidents/unCompromise/draw"
                    }
                  ]
                },
                {
                  "type": "secondary_btn",
                  "text": "مرحله قبل",
                  "width": {
                    "type": "match_parent",
                    "weight": 1
                  },
                  "margins": {
                    "top": 0,
                    "end": 4
                  },
                  "actions": [
                    {
                      "log_id": "load_screen",
                      "url": "div-action://pop_and_load_screen"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
