{
  "templates": {
    "page_title": {
      "type": "text",
      "font_size": 14,
      "font_weight": "medium",
      "text_color": "#193d8d",
      "text_alignment_horizontal": "right",
      "width": {
        "type": "wrap_content"
      },
      "height": {
        "type": "wrap_content"
      }
    },
    "section_label": {
      "type": "text",
      "font_size": 12,
      "font_weight": "medium",
      "text_color": "#6b7280",
      "text_alignment_horizontal": "right",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      },
      "margins": {
        "bottom": 6
      }
    }
  },
  "card": {
    "log_id": "accidents_ways",
    "variables": [
      {
        "type": "dict",
        "name": "local_palette",
        "value": {
          "bg_primary": {
            "name": "Primary background",
            "light": "#fff",
            "dark": "#000"
          },
          "color0": {
            "name": "Secondary background",
            "light": "#eeeeee",
            "dark": "#000"
          }
        }
      },
      {
        "type": "string",
        "name": "variable_tree_json",
        "value": ""
      },
      {
        "type": "string",
        "name": "variable_policeCenter",
        "value": ""
      },
      {
        "type": "string",
        "name": "variable_policeCenterCode",
        "value": ""
      },
      {
        "type": "string",
        "name": "variable_policeCenterId",
        "value": ""
      }
    ],
    "states": [
      {
        "state_id": 0,
        "div": {
          "type": "container",
          "orientation": "vertical",
          "width": {
            "type": "match_parent"
          },
          "height": {
            "type": "match_parent"
          },
          "background": [
            {
              "type": "solid",
              "color": "#ffffff"
            }
          ],
          "border": {
            "corners_radius": {
              "top-left": 16,
              "top-right": 16
            }
          },
          "content_alignment_vertical": "top",
          "content_alignment_horizontal": "right",
          "paddings": {
            "top": 8,
            "bottom": 12,
            "start": 16,
            "end": 16
          },
          "items": [
            {
              "type": "separator",
              "delimiter_style": {
                "color": "#d1d5db"
              },
              "width": {
                "type": "fixed",
                "value": 40
              },
              "height": {
                "type": "fixed",
                "value": 4
              },
              "alignment_horizontal": "center",
              "border": {
                "corner_radius": 2
              },
              "margins": {
                "bottom": 12
              }
            },
            {
              "type": "container",
              "orientation": "overlap",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "wrap_content"
              },
              "margins": {
                "bottom": 8
              },
              "items": [
                {
                  "type": "page_title",
                  "text": "انتخاب مرکز پلیس",
                  "font_size": 16,
                  "alignment_horizontal": "right"
                },
                {
                  "type": "text",
                  "text": "بستن",
                  "font_size": 13,
                  "text_color": "#193d8d",
                  "alignment_horizontal": "left",
                  "width": {
                    "type": "wrap_content"
                  },
                  "height": {
                    "type": "wrap_content"
                  },
                  "actions": [
                    {
                      "log_id": "close_ways_sheet",
                      "url": "div-action://close_bottom_sheet"
                    }
                  ]
                }
              ]
            },
            {
              "type": "section_label",
              "text": "مرکز پلیس را از ساختار سازمانی انتخاب کنید"
            },
            {
              "type": "container",
              "orientation": "vertical",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "match_parent",
                "weight": 1
              },
              "background": [
                {
                  "type": "solid",
                  "color": "#f3f5f9"
                }
              ],
              "border": {
                "corner_radius": 10,
                "stroke": {
                  "color": "#c8d0e4",
                  "width": 1
                }
              },
              "paddings": {
                "top": 8,
                "bottom": 8,
                "start": 8,
                "end": 8
              },
              "items": [
                {
                  "type": "custom",
                  "custom_type": "static_tree_view",
                  "custom_props": {
                    "json_data": "@{variable_tree_json}",
                    "name_variable": "variable_policeCenter",
                    "code_variable": "variable_policeCenterCode",
                    "id_variable": "variable_policeCenterId",
                    "confirm_text": "تأیید",
                    "variable_target": "base",
                    "selection_mode": "single",
                    "clear_variables_on_confirm": "variable_road,variable_road_code,variable_roads_ready",
                    "confirm_url": "div-action://call_service?path=roadsAccidents&sysName=accidents&ph/token=empty&policeCenterCode="
                  },
                  "height": {
                    "type": "match_parent"
                  },
                  "width": {
                    "type": "match_parent"
                  }
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
