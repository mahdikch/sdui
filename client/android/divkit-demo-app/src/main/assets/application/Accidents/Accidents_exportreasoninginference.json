{
  "templates": {
    "page_title": {
      "type": "text",
      "font_size": 14,
      "font_weight": "medium",
      "text_color": "#193d8d",
      "text_alignment_horizontal": "right",
      "width": {
        "type": "wrap_content"
      },
      "height": {
        "type": "wrap_content"
      }
    },
    "section_label": {
      "type": "text",
      "font_size": 12,
      "font_weight": "medium",
      "text_color": "#6b7280",
      "text_alignment_horizontal": "right",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      },
      "margins": {
        "bottom": 6
      }
    },
    "field_box": {
      "type": "container",
      "orientation": "vertical",
      "content_alignment_horizontal": "right",
      "content_alignment_vertical": "top",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      },
      "background": [
        {
          "type": "solid",
          "color": "#ffffff"
        }
      ],
      "border": {
        "corner_radius": 8,
        "stroke": {
          "color": "#c8d0e4",
          "width": 1
        }
      },
      "paddings": {
        "top": 10,
        "bottom": 10,
        "start": 12,
        "end": 12
      },
      "margins": {
        "bottom": 10
      }
    },
    "field_input": {
      "type": "input",
      "font_size": 13,
      "text_color": "#1f2937",
      "hint_color": "#9ca3af",
      "text_alignment_horizontal": "right",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      }
    },
    "validation_text": {
      "type": "text",
      "font_size": 12,
      "font_weight": "medium",
      "text_color": "#dc2626",
      "text_alignment_horizontal": "right",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      },
      "margins": {
        "bottom": 6
      }
    },
    "primary_btn": {
      "type": "text",
      "font_size": 14,
      "font_weight": "medium",
      "text_color": "#ffffff",
      "text_alignment_horizontal": "center",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      },
      "background": [
        {
          "type": "solid",
          "color": "#193d8d"
        }
      ],
      "border": {
        "corner_radius": 8
      },
      "paddings": {
        "top": 14,
        "bottom": 14
      }
    },
    "secondary_btn": {
      "type": "text",
      "font_size": 14,
      "font_weight": "medium",
      "text_color": "#193d8d",
      "text_alignment_horizontal": "center",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      },
      "background": [
        {
          "type": "solid",
          "color": "#f3f5f9"
        }
      ],
      "border": {
        "corner_radius": 8
      },
      "paddings": {
        "top": 14,
        "bottom": 14
      },
      "margins": {
        "top": 8
      }
    }
  },
  "card": {
    "log_id": "accidents_export_reasoning_inference",
    "variables": [
      {
        "type": "dict",
        "name": "local_palette",
        "value": {
          "bg_primary": {
            "name": "Primary background",
            "light": "#fff",
            "dark": "#000"
          },
          "color0": {
            "name": "Secondary background",
            "light": "#eeeeee",
            "dark": "#000"
          }
        }
      },
      {
        "type": "string",
        "name": "empty",
        "value": ""
      },
      {
        "type": "string",
        "name": "text___33",
        "value": "مرحله قبل"
      },
      {
        "type": "string",
        "name": "text___31",
        "value": "مرحله بعد"
      },
      {
        "type": "string",
        "name": "current_accident_id",
        "value": ""
      },
      {
        "type": "integer",
        "name": "current_step",
        "value": 3
      },
      {
        "type": "integer",
        "name": "total",
        "value": 4
      },
      {
        "type": "string",
        "name": "compromising_reasoning_officer_description",
        "value": ""
      },
      {
        "type": "boolean",
        "name": "validation_reasoning_officer_description",
        "value": false
      },
      {
        "type": "string",
        "name": "compromising_reasoning_officer_theory",
        "value": ""
      },
      {
        "type": "boolean",
        "name": "validation_reasoning_officer_theory",
        "value": false
      },
      {
        "type": "boolean",
        "name": "validation_next_page",
        "value": false
      },
      {
        "type": "boolean",
        "name": "attempted_next",
        "value": false
      }
    ],
    "variable_triggers": [
      {
        "condition": "@{compromising_reasoning_officer_description != empty}",
        "mode": "on_condition",
        "actions": [
          {
            "log_id": "description_ok",
            "url": "div-action://set_variable?name=validation_reasoning_officer_description&value=true"
          }
        ]
      },
      {
        "condition": "@{compromising_reasoning_officer_description == empty}",
        "mode": "on_condition",
        "actions": [
          {
            "log_id": "description_bad",
            "url": "div-action://set_variable?name=validation_reasoning_officer_description&value=false"
          }
        ]
      },
      {
        "condition": "@{compromising_reasoning_officer_theory != empty}",
        "mode": "on_condition",
        "actions": [
          {
            "log_id": "theory_ok",
            "url": "div-action://set_variable?name=validation_reasoning_officer_theory&value=true"
          }
        ]
      },
      {
        "condition": "@{compromising_reasoning_officer_theory == empty}",
        "mode": "on_condition",
        "actions": [
          {
            "log_id": "theory_bad",
            "url": "div-action://set_variable?name=validation_reasoning_officer_theory&value=false"
          }
        ]
      },
      {
        "condition": "@{validation_reasoning_officer_description && validation_reasoning_officer_theory}",
        "mode": "on_condition",
        "actions": [
          {
            "log_id": "next_ok",
            "url": "div-action://set_variable?name=validation_next_page&value=true"
          }
        ]
      },
      {
        "condition": "@{!validation_reasoning_officer_description || !validation_reasoning_officer_theory}",
        "mode": "on_condition",
        "actions": [
          {
            "log_id": "next_bad",
            "url": "div-action://set_variable?name=validation_next_page&value=false"
          }
        ]
      }
    ],
    "states": [
      {
        "state_id": 0,
        "div": {
          "type": "container",
          "orientation": "vertical",
          "width": {
            "type": "match_parent"
          },
          "height": {
            "type": "match_parent"
          },
          "background": [
            {
              "type": "solid",
              "color": "#ffffff"
            }
          ],
          "paddings": {
            "top": 12,
            "bottom": 12,
            "start": 16,
            "end": 16
          },
          "visibility_action": {
            "log_id": "visible"
          },
          "visibility_actions": [
            {
              "log_id": "load_accident_id",
              "url": "div-action://set_variable_from_db?name=current_accident_id",
              "visibility_duration": 0
            }
          ],
          "items": [
            {
              "type": "container",
              "orientation": "overlap",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "wrap_content"
              },
              "margins": {
                "bottom": 8
              },
              "items": [
                {
                  "type": "page_title",
                  "text": "ثبت تصادف سازشی",
                  "alignment_horizontal": "right"
                },
                {
                  "type": "text",
                  "text": "بازگشت",
                  "font_size": 12,
                  "text_color": "#193d8d",
                  "alignment_horizontal": "left",
                  "width": {
                    "type": "wrap_content"
                  },
                  "height": {
                    "type": "wrap_content"
                  },
                  "actions": [
                    {
                      "log_id": "back",
                      "url": "div-action://pop_and_load_screen"
                    }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "orientation": "horizontal",
              "content_alignment_vertical": "center",
              "content_alignment_horizontal": "right",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "wrap_content"
              },
              "background": [
                {
                  "type": "solid",
                  "color": "#f3f5f9"
                }
              ],
              "border": {
                "corner_radius": 8
              },
              "paddings": {
                "top": 6,
                "bottom": 6,
                "start": 8,
                "end": 8
              },
              "margins": {
                "bottom": 8
              },
              "items": [
                {
                  "type": "custom",
                  "custom_type": "circular_progress",
                  "custom_props": {
                    "current": "@{current_step}",
                    "total": "@{total}"
                  },
                  "width": {
                    "type": "fixed",
                    "value": 36
                  },
                  "height": {
                    "type": "fixed",
                    "value": 36
                  },
                  "margins": {
                    "end": 8
                  }
                },
                {
                  "type": "container",
                  "orientation": "vertical",
                  "width": {
                    "type": "match_parent"
                  },
                  "height": {
                    "type": "wrap_content"
                  },
                  "items": [
                    {
                      "type": "text",
                      "text": "استدلال و استنتاج کارشناسی",
                      "font_size": 12,
                      "font_weight": "medium",
                      "text_color": "#1f2937",
                      "text_alignment_horizontal": "right",
                      "width": {
                        "type": "match_parent"
                      },
                      "height": {
                        "type": "wrap_content"
                      }
                    },
                    {
                      "type": "text",
                      "text": "بعدی: ثبت نهایی",
                      "font_size": 10,
                      "text_color": "#6b7280",
                      "text_alignment_horizontal": "right",
                      "width": {
                        "type": "match_parent"
                      },
                      "height": {
                        "type": "wrap_content"
                      },
                      "margins": {
                        "top": 1
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "gallery",
              "orientation": "vertical",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "match_parent",
                "weight": 1
              },
              "items": [
                {
                  "type": "container",
                  "orientation": "vertical",
                  "width": {
                    "type": "match_parent"
                  },
                  "height": {
                    "type": "wrap_content"
                  },
                  "background": [
                    {
                      "type": "solid",
                      "color": "#fef2f2"
                    }
                  ],
                  "border": {
                    "corner_radius": 8
                  },
                  "paddings": {
                    "top": 10,
                    "bottom": 6,
                    "start": 12,
                    "end": 12
                  },
                  "margins": {
                    "bottom": 10
                  },
                  "visibility": "@{attempted_next && !validation_next_page ? 'visible' : 'gone'}",
                  "items": [
                    {
                      "type": "text",
                      "text": "لطفاً موارد الزامی را تکمیل کنید",
                      "font_size": 13,
                      "font_weight": "medium",
                      "text_color": "#b91c1c",
                      "text_alignment_horizontal": "right",
                      "width": {
                        "type": "match_parent"
                      },
                      "height": {
                        "type": "wrap_content"
                      },
                      "margins": {
                        "bottom": 6
                      }
                    },
                    {
                      "type": "validation_text",
                      "text": "توضیحات کارشناسی اجباری می باشد.",
                      "visibility": "@{validation_reasoning_officer_description ? 'gone' : 'visible'}"
                    },
                    {
                      "type": "validation_text",
                      "text": "نظریه کارشناسی اجباری می باشد.",
                      "visibility": "@{validation_reasoning_officer_theory ? 'gone' : 'visible'}"
                    }
                  ]
                },
                {
                  "type": "section_label",
                  "text": "توضیحات کارشناسی *"
                },
                {
                  "type": "field_box",
                  "items": [
                    {
                      "type": "field_input",
                      "text_variable": "compromising_reasoning_officer_description",
                      "hint_text": "توضیحات کارشناسی را وارد کنید",
                      "height": {
                        "type": "fixed",
                        "value": 96
                      }
                    }
                  ]
                },
                {
                  "type": "section_label",
                  "text": "نظریه کارشناسی *"
                },
                {
                  "type": "field_box",
                  "items": [
                    {
                      "type": "field_input",
                      "text_variable": "compromising_reasoning_officer_theory",
                      "hint_text": "نظریه کارشناسی را وارد کنید",
                      "height": {
                        "type": "fixed",
                        "value": 96
                      }
                    }
                  ]
                },
                {
                  "type": "section_label",
                  "text": "مقصرین"
                },
                {
                  "type": "container",
                  "orientation": "vertical",
                  "width": {
                    "type": "match_parent"
                  },
                  "height": {
                    "type": "wrap_content"
                  },
                  "background": [
                    {
                      "type": "solid",
                      "color": "#f8fafc"
                    }
                  ],
                  "border": {
                    "corner_radius": 8,
                    "stroke": {
                      "color": "#c8d0e4",
                      "width": 1
                    }
                  },
                  "paddings": {
                    "top": 10,
                    "bottom": 10,
                    "start": 10,
                    "end": 10
                  },
                  "margins": {
                    "bottom": 8
                  },
                  "items": [
                    {
                      "type": "text",
                      "text": "لیست رانندگان مقصر بر اساس اطلاعات ثبت‌شده وسایل نقلیه",
                      "font_size": 11,
                      "text_color": "#6b7280",
                      "text_alignment_horizontal": "right",
                      "width": {
                        "type": "match_parent"
                      },
                      "height": {
                        "type": "wrap_content"
                      },
                      "margins": {
                        "bottom": 8
                      }
                    },
                    {
                      "type": "custom",
                      "custom_type": "fault_drivers_list",
                      "custom_props": {
                        "accident_id": "@{current_accident_id}"
                      },
                      "width": {
                        "type": "match_parent"
                      },
                      "height": {
                        "type": "wrap_content"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "orientation": "horizontal",
              "content_alignment_vertical": "center",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "wrap_content"
              },
              "margins": {
                "top": 10
              },
              "items": [
                {
                  "type": "primary_btn",
                  "text": "@{text___31}",
                  "width": {
                    "type": "match_parent",
                    "weight": 1
                  },
                  "margins": {
                    "start": 4
                  },
                  "actions": [
                    {
                      "log_id": "attempt_show_errors",
                      "is_enabled": "@{!validation_next_page}",
                      "url": "div-action://set_variable?name=attempted_next&value=true"
                    },
                    {
                      "log_id": "toast_validation",
                      "is_enabled": "@{!validation_next_page}",
                      "url": "div-action://show_toast?massage=لطفاً فیلدهای الزامی را تکمیل کنید"
                    },
                    {
                      "log_id": "save_draft_page3",
                      "is_enabled": "@{validation_next_page}",
                      "url": "div-action://set_page_with_changes_to_db?key=draft/@{current_accident_id}/page3"
                    },
                    {
                      "log_id": "save_to_db",
                      "is_enabled": "@{validation_next_page}",
                      "url": "div-action://set_variable_to_db?key=compromising_reasoning_officer_description/@{current_accident_id}&value=@{compromising_reasoning_officer_description}"
                    },
                    {
                      "log_id": "save_to_db",
                      "is_enabled": "@{validation_next_page}",
                      "url": "div-action://set_variable_to_db?key=compromising_reasoning_officer_theory/@{current_accident_id}&value=@{compromising_reasoning_officer_theory}"
                    },
                    {
                      "log_id": "save_archive_index",
                      "is_enabled": "@{validation_next_page}",
                      "url": "div-action://set_object_to_db?archive_path=Accidents&next=draft/@{current_accident_id}/page3&title=ثبت تصادف سازشی&accident_id=@{current_accident_id}&current_step=4&process_type=sazeshi&step_dbshow=صفحه ۳ از ۴&step_persian_lan=مرحله&accident_id_dbshow=@{current_accident_id}&accident_id_persian_lan=شناسه"
                    },
                    {
                      "log_id": "set_step",
                      "is_enabled": "@{validation_next_page}",
                      "url": "div-action://set_variable_to_db?key=current_step&value=4"
                    },
                    {
                      "log_id": "show_bottom_sheet",
                      "is_enabled": "@{validation_next_page}",
                      "url": "div-action://load_screen?screen=Accidents/finalregistration"
                    }
                  ]
                },
                {
                  "type": "secondary_btn",
                  "text": "@{text___33}",
                  "width": {
                    "type": "match_parent",
                    "weight": 1
                  },
                  "margins": {
                    "top": 0,
                    "end": 4
                  },
                  "actions": [
                    {
                      "log_id": "save_draft_page3",
                      "url": "div-action://set_page_with_changes_to_db?key=draft/@{current_accident_id}/page3"
                    },
                    {
                      "log_id": "set_step",
                      "url": "div-action://set_variable_to_db?key=current_step&value=2"
                    },
                    {
                      "log_id": "load_screen",
                      "url": "div-action://pop_and_load_screen"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
