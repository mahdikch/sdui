                    "type": "match_parent",
                    "weight": 1
                  },
                  "margins": {
                    "start": 4
                  },
                  "actions": [
                    {
                      "log_id": "save_draw_draft",
                      "url": "div-action://set_page_with_changes_to_db?key=draft/@{current_accident_id}/page9"
                    },
                    {
                      "log_id": "go_previous_step",
                      "url": "div-action://load_screen?screen=Accidents/uncompromising/expertreasoning"
                    }
                  ]
                },
                {
                  "type": "secondary_btn",
                  "text": "مرحله بعد",
                  "width": {
                    "type": "match_parent",
                    "weight": 1
                  },
                  "margins": {
                    "top": 0,
                    "end": 4
                  },
                  "actions": [
                    {
                      "log_id": "save_draw_draft_next",
                      "url": "div-action://set_page_with_changes_to_db?key=draft/@{current_accident_id}/page9"
                    },
                    {
                      "log_id": "set_step",
                      "url": "div-action://set_variable_to_db?key=current_step&value=10"
                    },
                    {
                      "log_id": "load_screen",
                      "url": "div-action://load_screen?screen=Accidents/uncompromising/preview"
                    }
                  ]
                }
              ]
            }
          ],
          "visibility_actions": [
            {
              "log_id": "load_accident_id",
              "url": "div-action://set_variable_from_db?name=current_accident_id",
              "visibility_duration": 0
            }
          ]
        }
