{
  "templates": {
    "page_title": {
      "type": "text",
      "font_size": 14,
      "font_weight": "medium",
      "text_color": "#193d8d",
      "text_alignment_horizontal": "right",
      "width": {
        "type": "wrap_content"
      },
      "height": {
        "type": "wrap_content"
      }
    },
    "section_label": {
      "type": "text",
      "font_size": 12,
      "font_weight": "medium",
      "text_color": "#6b7280",
      "text_alignment_horizontal": "right",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      },
      "margins": {
        "bottom": 6
      }
    },
    "primary_btn": {
      "type": "text",
      "font_size": 14,
      "font_weight": "medium",
      "text_color": "#ffffff",
      "text_alignment_horizontal": "center",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      },
      "background": [
        {
          "type": "solid",
          "color": "#193d8d"
        }
      ],
      "border": {
        "corner_radius": 10
      },
      "paddings": {
        "top": 14,
        "bottom": 14
      }
    },
    "secondary_btn": {
      "type": "text",
      "font_size": 14,
      "font_weight": "medium",
      "text_color": "#193d8d",
      "text_alignment_horizontal": "center",
      "width": {
        "type": "match_parent"
      },
      "height": {
        "type": "wrap_content"
      },
      "background": [
        {
          "type": "solid",
          "color": "#ffffff"
        }
      ],
      "border": {
        "corner_radius": 10,
        "stroke": {
          "color": "#c8d0e4",
          "width": 1
        }
      },
      "paddings": {
        "top": 14,
        "bottom": 14
      }
    }
  },
  "card": {
    "log_id": "accidents_uncompromising_draw",
    "variables": [
      {
        "type": "string",
        "name": "empty",
        "value": ""
      },
      {
        "type": "string",
        "name": "current_accident_id",
        "value": ""
      },
      {
        "type": "integer",
        "name": "current_step",
        "value": 9
      },
      {
        "type": "integer",
        "name": "total",
        "value": 10
      },
      {
        "type": "string",
        "name": "uncompromising_accident_sketch_json",
        "value": ""
      },
      {
        "type": "string",
        "name": "uncompromising_accident_sketch_image",
        "value": ""
      },
      {
        "type": "string",
        "name": "uncompromising_accident_sketch_sound",
        "value": ""
      }
    ],
    "states": [
      {
        "state_id": 0,
        "div": {
          "type": "container",
          "orientation": "vertical",
          "width": {
            "type": "match_parent"
          },
          "height": {
            "type": "match_parent"
          },
          "background": [
            {
              "type": "solid",
              "color": "#f3f5f9"
            }
          ],
          "paddings": {
            "top": 12,
            "bottom": 12,
            "start": 16,
            "end": 16
          },
          "visibility_actions": [
            {
              "log_id": "load_accident_id",
              "url": "div-action://set_variable_from_db?name=current_accident_id",
              "visibility_duration": 0
            }
          ],
          "items": [
            {
              "type": "container",
              "orientation": "overlap",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "wrap_content"
              },
              "margins": {
                "bottom": 10
              },
              "items": [
                {
                  "type": "page_title",
                  "text": "ثبت تصادف غیرسازشی",
                  "alignment_horizontal": "right"
                },
                {
                  "type": "text",
                  "text": "بازگشت",
                  "font_size": 12,
                  "text_color": "#193d8d",
                  "alignment_horizontal": "left",
                  "width": {
                    "type": "wrap_content"
                  },
                  "height": {
                    "type": "wrap_content"
                  },
                  "actions": [
                    {
                      "log_id": "back",
                      "url": "div-action://pop_and_load_screen"
                    }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "orientation": "horizontal",
              "content_alignment_vertical": "center",
              "content_alignment_horizontal": "right",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "wrap_content"
              },
              "background": [
                {
                  "type": "solid",
                  "color": "#ffffff"
                }
              ],
              "border": {
                "corner_radius": 12,
                "stroke": {
                  "color": "#dbe3f0",
                  "width": 1
                }
              },
              "paddings": {
                "top": 10,
                "bottom": 10,
                "start": 12,
                "end": 12
              },
              "margins": {
                "bottom": 10
              },
              "items": [
                {
                  "type": "custom",
                  "custom_type": "circular_progress",
                  "custom_props": {
                    "current": "@{current_step}",
                    "total": "@{total}"
                  },
                  "width": {
                    "type": "fixed",
                    "value": 40
                  },
                  "height": {
                    "type": "fixed",
                    "value": 40
                  },
                  "margins": {
                    "end": 10
                  }
                },
                {
                  "type": "container",
                  "orientation": "vertical",
                  "width": {
                    "type": "match_parent"
                  },
                  "height": {
                    "type": "wrap_content"
                  },
                  "items": [
                    {
                      "type": "text",
                      "text": "کروکی تصادف",
                      "font_size": 13,
                      "font_weight": "medium",
                      "text_color": "#1f2937",
                      "text_alignment_horizontal": "right",
                      "width": {
                        "type": "match_parent"
                      },
                      "height": {
                        "type": "wrap_content"
                      }
                    },
                    {
                      "type": "text",
                      "text": "مرحله @{current_step} از @{total}  ·  بعدی: پیش‌نمایش اطلاعات",
                      "font_size": 11,
                      "text_color": "#6b7280",
                      "text_alignment_horizontal": "right",
                      "width": {
                        "type": "match_parent"
                      },
                      "height": {
                        "type": "wrap_content"
                      },
                      "margins": {
                        "top": 2
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "orientation": "horizontal",
              "content_alignment_vertical": "center",
              "content_alignment_horizontal": "right",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "wrap_content"
              },
              "background": [
                {
                  "type": "solid",
                  "color": "#eef3fb"
                }
              ],
              "border": {
                "corner_radius": 10
              },
              "paddings": {
                "top": 10,
                "bottom": 10,
                "start": 12,
                "end": 12
              },
              "margins": {
                "bottom": 12
              },
              "items": [
                {
                  "type": "text",
                  "text": "موقعیت وسایل، جهت حرکت و علائم صحنه را روی کروکی مشخص کنید.",
                  "font_size": 11,
                  "text_color": "#3b5b9a",
                  "text_alignment_horizontal": "right",
                  "width": {
                    "type": "match_parent"
                  },
                  "height": {
                    "type": "wrap_content"
                  }
                }
              ]
            },
            {
              "type": "gallery",
              "orientation": "vertical",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "match_parent",
                "weight": 1
              },
              "items": [
                {
                  "type": "section_label",
                  "text": "فضای رسم کروکی"
                },
                {
                  "type": "container",
                  "orientation": "vertical",
                  "width": {
                    "type": "match_parent"
                  },
                  "height": {
                    "type": "wrap_content"
                  },
                  "background": [
                    {
                      "type": "solid",
                      "color": "#ffffff"
                    }
                  ],
                  "border": {
                    "corner_radius": 12,
                    "stroke": {
                      "color": "#dbe3f0",
                      "width": 1
                    }
                  },
                  "paddings": {
                    "top": 10,
                    "bottom": 10,
                    "start": 10,
                    "end": 10
                  },
                  "margins": {
                    "bottom": 8
                  },
                  "items": [
                    {
                      "type": "custom",
                      "custom_type": "accident_sketch",
                      "custom_props": {
                        "variable_name": "uncompromising_accident_sketch_json",
                        "image_variable": "uncompromising_accident_sketch_image",
                        "sound_variable": "uncompromising_accident_sketch_sound"
                      },
                      "width": {
                        "type": "match_parent"
                      },
                      "height": {
                        "type": "fixed",
                        "value": 560
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "container",
              "orientation": "horizontal",
              "content_alignment_vertical": "center",
              "width": {
                "type": "match_parent"
              },
              "height": {
                "type": "wrap_content"
              },
              "margins": {
                "top": 10
              },
              "items": [
                {
                  "type": "primary_btn",
                  "text": "مرحله بعد",
                  "width": {
                    "type": "match_parent",
                    "weight": 1
                  },
                  "margins": {
                    "start": 4
                  },
                  "actions": [
                    {
                      "log_id": "save_draw_draft_next",
                      "url": "div-action://set_page_with_changes_to_db?key=draft/@{current_accident_id}/page9"
                    },
                    {
                      "log_id": "set_step",
                      "url": "div-action://set_variable_to_db?key=current_step&value=10"
                    },
                    {
                      "log_id": "load_screen",
                      "url": "div-action://load_screen?screen=Accidents/uncompromising/preview"
                    }
                  ]
                },
                {
                  "type": "secondary_btn",
                  "text": "مرحله قبل",
                  "width": {
                    "type": "match_parent",
                    "weight": 1
                  },
                  "margins": {
                    "end": 4
                  },
                  "actions": [
                    {
                      "log_id": "save_draw_draft",
                      "url": "div-action://set_page_with_changes_to_db?key=draft/@{current_accident_id}/page9"
                    },
                    {
                      "log_id": "go_previous_step",
                      "url": "div-action://load_screen?screen=Accidents/uncompromising/expertreasoning"
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
