<?xml version="1.0" encoding="utf-8"?>
<!-- merge: attach directly to NotificationListView (avoid nested match_parent LinearLayout) -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/notification_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layoutDirection="ltr"
        android:gravity="end|center_vertical"
        android:background="#F3F5F9"
        android:elevation="4dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:clipChildren="true"
        android:clipToPadding="true">

        <TextView
            android:id="@+id/mark_all_read"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="خوانده شده"
            android:textSize="14sp"
            android:textColor="@android:color/holo_blue_dark"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:visibility="gone" />

        <TextView
            android:id="@+id/notification_list_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text=""
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#193D8D"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/notification_title_filter_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layoutDirection="rtl"
            android:gravity="center_vertical"
            android:background="@drawable/notification_filter_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:minHeight="40dp"
            android:minWidth="120dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@android:drawable/ic_menu_search"
                android:tint="#193D8D"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/notification_title_filter_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="6dp"
                android:gravity="center_vertical|start"
                android:text="همه"
                android:textSize="14sp"
                android:textColor="#1F2937"
                android:maxLines="1"
                android:ellipsize="end"
                android:maxWidth="140dp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/arrow_down_float"
                android:tint="#6B7280"
                android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true"
        android:clipToPadding="true">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/notifications_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="true"
            android:clipChildren="true"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="160dp"
            android:scrollbars="vertical"
            android:overScrollMode="ifContentScrolls" />

        <TextView
            android:id="@+id/empty_state_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="هیچ اعلانی وجود ندارد"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorSecondary"
            android:gravity="center"
            android:visibility="gone"
            android:drawableTop="@drawable/ic_notification"
            android:drawablePadding="16dp"
            android:drawableTint="?android:attr/textColorSecondary" />
    </FrameLayout>

</merge>
