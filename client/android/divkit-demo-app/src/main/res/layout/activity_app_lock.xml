<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F3F5F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="رمز ورود"
            android:textColor="#193D8D"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/typeChooser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnChoosePin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="PIN"
                android:backgroundTint="#193D8D"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnChoosePattern"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="الگو"
                android:backgroundTint="#193D8D"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/pinDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#193D8D"
            android:textSize="28sp"
            android:letterSpacing="0.3"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <GridLayout
            android:id="@+id/pinPad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:alignmentMode="alignMargins"
            android:visibility="gone"
            android:layout_gravity="center_horizontal" />

        <com.yandex.divkit.demo.applock.PatternLockView
            android:id="@+id/patternView"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="center_horizontal"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnBiometric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="اثرانگشت / تشخیص چهره"
            android:backgroundTint="#C8D0E4"
            android:textColor="#193D8D"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnConfirmPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="تأیید"
            android:backgroundTint="#193D8D"
            android:textColor="#FFFFFF"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="پاک کردن"
            android:backgroundTint="#EEF2F8"
            android:textColor="#193D8D"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
