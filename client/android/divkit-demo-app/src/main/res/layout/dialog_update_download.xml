<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_loading_dialog"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#D1D5DB" />

        <TextView
            android:id="@+id/txtUpdateTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/irsans"
            android:gravity="center"
            android:text="به‌روزرسانی برنامه"
            android:textColor="#193D8D"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtUpdateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/irsans"
            android:gravity="center"
            android:text="در حال آماده‌سازی دانلود..."
            android:textColor="#6B7280"
            android:textSize="13sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:indeterminate="true"
            app:indicatorColor="#193D8D"
            app:trackColor="#E8EDF7"
            app:trackThickness="8dp" />

        <TextView
            android:id="@+id/txtUpdatePercent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/irsans"
            android:gravity="center"
            android:text="۰٪"
            android:textColor="#193D8D"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnUpdateCancel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#EEF2F8"
            android:fontFamily="@font/irsans"
            android:text="انصراف"
            android:textColor="#193D8D"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
