<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_loading_dialog"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#D1D5DB" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/irsans"
            android:gravity="center"
            android:text="خروج از برنامه"
            android:textColor="#193D8D"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/irsans"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="آیا می‌خواهید از برنامه خارج شوید؟"
            android:textColor="#4B5563"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExitCancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:fontFamily="@font/irsans"
                android:text="انصراف"
                android:textColor="#193D8D"
                app:cornerRadius="12dp"
                app:strokeColor="#193D8D" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExitConfirm"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="@font/irsans"
                android:text="خروج"
                android:textColor="#FFFFFF"
                app:backgroundTint="#193D8D"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
