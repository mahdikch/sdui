<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Library default: no cleartext, trust system + push CA only (never user CAs). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="@raw/push_ca"/>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
    <domain-config>
        <domain includeSubdomains="true">pishgiri.naja.net</domain>
        <trust-anchors>
            <certificates src="@raw/push_ca"/>
            <certificates src="system"/>
        </trust-anchors>
    </domain-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user"/>
            <certificates src="system"/>
            <certificates src="@raw/push_ca"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config>
